# Career OS Environment Configuration Template
# Copy this file to .env before running LLM synthesis features

# OpenAI API Key (optional — for OpenAI LLM provider in packages/ai-engine)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (optional — for Anthropic LLM provider in packages/ai-engine)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Node environment
NODE_ENV=development

# Host Port Mapping (if 3000 is occupied locally, change to 3005 or any free port)
PORT=3005
