# Port Mappings (avoiding host collisions: 8000, 8001, 3000, 3001, 5432)
BACKEND_PORT=8002
FRONTEND_PORT=3002
POSTGRES_PORT=5433

# Backend Settings
SECRET_KEY=django-insecure-career-os-v2-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Settings
POSTGRES_DB=career_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=localhost
USE_SQLITE=False

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8002/api/v1
