{
  "name": "@career-os/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Typed query SDK over the canonical ContentGraph for Career OS consumers (website, API, CLI, agents). Single read-only data access layer (P4, P5, P6).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src/",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@career-os/content-parser": "workspace:*",
    "@career-os/content-schema": "workspace:*",
    "@career-os/shared-utils": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
