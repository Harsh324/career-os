{
  "name": "@career-os/content-schema",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas and inferred TypeScript types for all Career OS content types. This is the single type authority for the entire platform.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src/",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
