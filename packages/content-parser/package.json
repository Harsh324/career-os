{
  "name": "@career-os/content-parser",
  "version": "0.0.0",
  "private": true,
  "description": "Transforms raw Markdown files from content/raw/ into a validated, normalized ContentGraph. The only package that reads from content/raw/ — consumers never touch raw content directly (P6).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@career-os/content-schema": "workspace:*",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.2.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
