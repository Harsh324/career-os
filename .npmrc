# pnpm configuration
# https://pnpm.io/npmrc

# Automatically install peer dependencies
auto-install-peers=true

# Do not fail on unresolved peer dependencies (some packages have loose peer specs)
strict-peer-dependencies=false

# Use symlinks for local workspace packages (default for pnpm)
link-workspace-packages=true

# Hoist shared dependencies to root node_modules for better IDE resolution
# Required for ESLint, TypeScript, and Prettier to resolve from root
shamefully-hoist=false
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=typescript
