{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Compilation target — ES2022 for modern Node.js (18+)
    "target": "ES2022",
    "lib": ["ES2022"],

    // Module system — NodeNext for server-side packages
    // Apps (Next.js) override this to "bundler"
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Declaration output — required for cross-package type resolution
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,

    // Strict type checking — all flags enabled (P7 — deterministic output)
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Interop
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // Output (overridden per-package)
    "outDir": "dist",
    "rootDir": "src"
  },
  "exclude": ["node_modules", "dist", ".turbo"]
}
