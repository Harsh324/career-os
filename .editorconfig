root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
# Preserve trailing spaces in Markdown (two spaces = line break)
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
# Makefiles require tabs
indent_style = tab
indent_size = 4

[*.yml]
indent_size = 2

[*.json]
indent_size = 2
